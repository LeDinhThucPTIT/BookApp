APP_NAME=BookApp API
APP_ENV=development
DEBUG=true

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=bookapp

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REDIS_URL=

CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=6/minute

MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=you@gmail.com
# Optional legacy alias. Leave empty to use JWT_SECRET_KEY.
FLASK_SECRET_KEY=

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
